{
  "name": "authenik8",
  "private": true,
  "version": "0.0.0",
  "description": "Authenik8 ecosystem workspace: identity-aware AI development foundations.",
  "type": "module",
  "workspaces": [
    "packages/*",
    "apps/*"
  ],
  "scripts": {
    "dev": "npm run dev --workspace @authenik8/marketing",
    "build": "npm run build --workspaces --if-present",
    "package:windows": "npm run build && node scripts/package-windows-studio.mjs",
    "test": "npm run test --workspaces --if-present",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "canon:audit": "node packages/engineering-canon/dist/cli.js . --baseline canon-baseline.json",
    "canon:baseline": "node packages/engineering-canon/dist/cli.js . --write-baseline canon-baseline.json",
    "canon:test": "npm run test --workspace @authenik8/engineering-canon"
  },
  "engines": {
    "node": ">=22"
  }
}
