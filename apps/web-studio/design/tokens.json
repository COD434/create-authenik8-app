{
  "schemaVersion": 1,
  "name": "Authenik8 Studio",
  "color": {
    "groups": {
      "surface": {
        "base": "#0A0D16",
        "raised": "#131828",
        "field": "#181F32",
        "line": "#232C44"
      },
      "ink": {
        "high": "#F2F5FA",
        "mid": "#C2CADA",
        "low": "#8B94A7"
      },
      "accent": {
        "primary": "#F5B942",
        "secondary": "#6C8CFF",
        "onPrimary": "#14171F"
      },
      "status": {
        "danger": "#FF6C6C"
      }
    },
    "contrastPairs": [
      { "foreground": "color.ink.high", "background": "color.surface.base", "kind": "body" },
      { "foreground": "color.ink.mid", "background": "color.surface.base", "kind": "body" },
      { "foreground": "color.ink.low", "background": "color.surface.base", "kind": "body" },
      { "foreground": "color.ink.high", "background": "color.surface.raised", "kind": "body" },
      { "foreground": "color.ink.low", "background": "color.surface.raised", "kind": "body" },
      { "foreground": "color.ink.mid", "background": "color.surface.field", "kind": "body" },
      { "foreground": "color.accent.onPrimary", "background": "color.accent.primary", "kind": "body" },
      { "foreground": "color.status.danger", "background": "color.surface.base", "kind": "body" }
    ]
  },
  "typography": {
    "family": "system-ui, 'Segoe UI', Roboto, 'Cascadia Code', sans-serif",
    "scale": { "xs": "0.75rem", "sm": "0.875rem", "md": "1rem", "lg": "1.25rem", "xl": "1.5rem" }
  },
  "spacing": {
    "scale": { "xs": "4px", "sm": "8px", "md": "16px", "lg": "24px", "xl": "32px" }
  }
}
