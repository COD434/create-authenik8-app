{
  "name": "authenik8-app",
  "scripts": {
    "dev": "tsx watch ./src/server.ts",
    "build": "tsc",
    "start": "node dist/src/server.js",

    "db:migrate": "prisma db push && prisma generate",
    "prisma:migrate": "prisma db push && prisma generate",

    "docker:up": "docker compose up -d",

    "docker:down": "docker compose down"
  },
  "dependencies": {
    "authenik8-core": "2.0.7",
    "dotenv": "^16.0.0",
    "express": "^4.18.2",
    "@prisma/client": "7.9.0",
    "ioredis": "^5.8.1",

    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@types/express": "^4.17.21",
    "@types/node": "^22.10.2",

    "ioredis-mock": "8.13.1",
    "prisma": "7.9.1",
    "tsx": "^4.22.4",
    "typescript": "^5.0.0"
  },
  "overrides": {
    "find-my-way": "9.7.0",
    "valibot": "1.4.2"
  },
  "type": "commonjs"
}
