{
  "name": "@authenik8/agent-adapter",
  "version": "0.1.0",
  "description": "Documented adapter interface over coding-agent runtimes (OpenCode first) so the Authenik8 ecosystem can swap runtimes without rewrites.",
  "type": "module",
  "license": "MIT",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "README.md"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "typescript": "^5.6.0",
    "vitest": "^4.1.12"
  },
  "engines": {
    "node": ">=22"
  }
}
