{
  "schemaVersion": 1,
  "name": "authenik8 example dark brand",
  "color": {
    "groups": {
      "base": {
        "background": "#0B1020",
        "surface": "#111832",
        "ink": "#E8ECF8",
        "ink-muted": "#9AA3BF",
        "accent": "#F5B942",
        "danger": "#E5484D"
      }
    },
    "contrastPairs": [
      { "foreground": "color.base.ink", "background": "color.base.background", "kind": "body" },
      { "foreground": "color.base.ink", "background": "color.base.surface", "kind": "body" },
      { "foreground": "color.base.ink-muted", "background": "color.base.background", "kind": "body" },
      { "foreground": "color.base.accent", "background": "color.base.background", "kind": "large" }
    ]
  },
  "typography": {
    "family": "system-ui, sans-serif",
    "scale": { "sm": "0.875rem", "md": "1rem", "lg": "1.25rem", "xl": "1.5rem" }
  },
  "spacing": {
    "scale": { "xs": "4px", "sm": "8px", "md": "16px", "lg": "32px" }
  }
}
