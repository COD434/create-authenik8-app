{
  "name": "@authenik8/engineering-canon",
  "version": "0.1.0",
  "description": "The Authenik8 engineering canon: distilled, cited rules for architecture and readability, plus skills, review agents, and a mechanical audit.",
  "type": "module",
  "license": "MIT",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "bin": {
    "authenik8-canon": "./dist/cli.js"
  },
  "files": [
    "dist",
    "canon",
    "skills",
    "README.md"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run",
    "audit": "node dist/cli.js ."
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "typescript": "^5.6.0",
    "vitest": "^3.0.0"
  },
  "engines": {
    "node": ">=22"
  }
}
